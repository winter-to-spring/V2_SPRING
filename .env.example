# V2_SPRING 로컬 기본 환경 프로필
# 로컬 호스트 기반 개발에는 이 파일을 사용합니다.
# Docker 네트워크 또는 VM 배포 예시는 아래 파일을 참고하세요:
# - infra/env/local.env.example
# - infra/env/docker.env.example
# - infra/env/vm.env.example

# 런타임
APP_ENV=local
TZ=Asia/Seoul
LOG_LEVEL=info

# 저장소 / 인프라
POSTGRES_IMAGE=postgres:17.9-bookworm
POSTGRES_DB=v2_spring
POSTGRES_USER=v2_spring
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://v2_spring:change_me_postgres@localhost:5432/v2_spring

REDIS_IMAGE=redis:8.6
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Planner / 모델 어댑터
PLANNER_PROVIDER=scripted
PLANNER_OPENAI_MODEL=gpt-4o
PLANNER_ANTHROPIC_MODEL=claude-3-5-sonnet-latest
PLANNER_TIMEOUT_SECONDS=30
PLANNER_MAX_RETRIES=2
PLANNER_MAX_CONTEXT_CHARS=12000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 향후 선택형 실행 어댑터
GITHUB_TOKEN=
NOTION_TOKEN=
