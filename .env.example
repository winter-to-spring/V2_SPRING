# Runtime
APP_ENV=local
TZ=Asia/Seoul
LOG_LEVEL=info

# Postgres
POSTGRES_IMAGE=postgres:17.9-bookworm
POSTGRES_DB=v2_spring
POSTGRES_USER=v2_spring
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://v2_spring:change_me_postgres@localhost:5432/v2_spring

# Redis
REDIS_IMAGE=redis:8.6
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Model adapters
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Future execution adapters
GITHUB_TOKEN=
NOTION_TOKEN=
