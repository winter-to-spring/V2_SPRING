# V2_SPRING virtual-machine / single-host deployment profile
# Replace hostnames, passwords, and provider keys before use.

APP_ENV=production
TZ=Asia/Seoul
LOG_LEVEL=info

POSTGRES_IMAGE=postgres:17.9-bookworm
POSTGRES_DB=v2_spring
POSTGRES_USER=v2_spring
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://v2_spring:change_me_postgres@127.0.0.1:5432/v2_spring

REDIS_IMAGE=redis:8.6
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

PLANNER_PROVIDER=scripted
PLANNER_OPENAI_MODEL=gpt-4o
PLANNER_ANTHROPIC_MODEL=claude-3-5-sonnet-latest
PLANNER_TIMEOUT_SECONDS=30
PLANNER_MAX_RETRIES=2
PLANNER_MAX_CONTEXT_CHARS=12000

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
NOTION_TOKEN=
